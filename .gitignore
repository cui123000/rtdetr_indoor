# ===== .gitignore for rtdetr_indoor =====

# ---- Python artefacts ----
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.so

# ---- Virtualenv / caches ----
.cache/
venv/
env/

# ---- Large model weights (do not commit) ----
*.pt
*.pth
*.onnx
*.bin
*.safetensors

# ---- Dataset files (do not commit) ----
datasets/

# ---- Training outputs / logs ----
runs/
logs/

# ---- System / editor files ----
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo
*~

# ---- Misc ----
/root/autodl-tmp/

# End
# RT-DETR_1/ # 如果太大可以取消注释


